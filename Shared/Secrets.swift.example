import Foundation

/// Build-time configuration. This is a personal build — keys live here so the app
/// never has to ask the user for them.
///
/// Copy this file to `Secrets.swift` (which is gitignored) and paste your own keys in.
/// Leave a value empty to disable the feature that uses it.
enum Secrets {
    /// From console.anthropic.com → API keys. Powers plan generation.
    static let anthropicAPIKey = ""

    /// From console.cloud.google.com → Credentials → OAuth client ID → iOS.
    /// Looks like "123456-abc123.apps.googleusercontent.com".
    /// Optional — the Google sign-in button stays disabled until this is set.
    static let googleOAuthClientID = ""

    // MARK: - Sync (Mac ↔ iPhone)
    //
    // From your Supabase project → Project Settings → API. Paste the same three values
    // into this file on BOTH the Mac and iOS targets (it's the same Secrets.swift, so one
    // edit covers both once you rebuild each). Run SupabaseSchema.sql in Supabase's SQL
    // Editor once before using this.

    /// "Project URL", e.g. "https://xxxxxxxx.supabase.co". Empty disables sync entirely.
    static let supabaseURL = ""

    /// The "anon public" key (starts with "eyJ..."). Safe to embed in a build you compile
    /// yourself — see the security note in SupabaseSchema.sql for what that does and
    /// doesn't protect against.
    static let supabaseAnonKey = ""

    /// A pairing key you make up yourself — any string works, a UUID is a good choice.
    /// Paste the SAME value on every device you want syncing together; it's how rows are
    /// scoped to "you" without real multi-user auth. Generate one with:
    ///   uuidgen
    /// in Terminal, then paste it here once.
    static let syncGroupID = ""
}
